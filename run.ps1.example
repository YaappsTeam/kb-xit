# Copy this file to run.ps1 (already gitignored) and fill in your real
# credentials there. Never commit run.ps1 -- it will contain your live
# Telegram bot token. See CODING_STANDARDS.md section 7 for why
# credentials are always read from the environment, never baked into
# the build.
#
# Windows equivalent of run.sh.example -- use this instead if your
# terminal is PowerShell (bash scripts won't run there; see README.md
# Troubleshooting for why double-clicking run.sh doesn't work either).

$ErrorActionPreference = "Stop"

$env:TELEGRAM_BOT_TOKEN = "your-telegram-bot-token-here"
$env:TELEGRAM_CHAT_ID = "your-telegram-chat-id-here"
# $env:TRADING_MODE = "paper"   # optional -- "paper" is already the default

# Market data source: "simulated" (default) random-walks from your entry
# price; "live" streams real ticks from Upstox. Live data needs an Upstox
# Analytics Token -- generate one from the Developer Apps page (Analytics
# tab). It is valid for a year, is read-only, and cannot place orders, so
# no daily login is involved. Uncomment both lines to use live prices.
# $env:MARKET_DATA = "live"
# $env:UPSTOX_ANALYTICS_TOKEN = "your-upstox-analytics-token-here"

# Rupees to deploy per trade, used to size a bare "/track <symbol>" when you
# don't pass a quantity. Required whenever MARKET_DATA=live. Sizing is in
# whole lots and is capped at the exchange freeze limit (27 lots for NIFTY)
# rather than being split across several orders.
# $env:CAPITAL_PER_TRADE = "50000"

# Rupees you are willing to lose if the hard stop is hit. Optional but
# strongly recommended: without it, position size is capped by capital
# alone, so a stopped-out OPTIONS trade loses CAPITAL_PER_TRADE x 40%
# (Rs 20,000 on Rs 50,000). With it, the position is sized so the stop
# costs this much instead -- a wide stop on a smaller position, rather
# than a narrow stop that ordinary noise would trip. Adjustable at
# runtime with /risk <amount> or /risk off.
# $env:MAX_RISK_PER_TRADE = "5000"

# Newest by write time, not first alphabetically: after a version bump
# target/ can hold jars from several versions (plus the shade plugin's
# -shaded copy), and picking alphabetically silently runs a stale build.
# Close intraday positions at this wall-clock time, before your broker
# squares them off at whatever price it gets. Unset = no end-of-day
# close. The zone defaults to the market's (Asia/Kolkata), not the
# machine's -- a VM on UTC would otherwise fire hours late.
# $env:EOD_EXIT_TIME = "15:15"
# $env:EOD_TIMEZONE = "Asia/Kolkata"

# DANGER: when true, exits place REAL SELL orders with your broker.
# Off by default and never implied by any other setting. Also needs a
# /token each day and a registered static IP -- Upstox refuses orders
# from anywhere else, however valid the token is.
# $env:PLACE_REAL_ORDERS = "true"
# $env:ORDER_PRODUCT = "I"   # I = intraday, D = delivery

$jar = Get-ChildItem target -Filter "xit-mc-*.jar" |
    Where-Object { $_.Name -notlike "original-*" } |
    Sort-Object LastWriteTime -Descending |
    Select-Object -First 1

if (-not $jar) {
    Write-Error "No runnable jar found in target/. Run 'mvn package' first."
    exit 1
}

java -jar $jar.FullName
