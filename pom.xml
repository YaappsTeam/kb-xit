<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.kbquants</groupId>
  <artifactId>xit-mc</artifactId>
  <!-- Semantic Versioning (MAJOR.MINOR.PATCH); see CODING_STANDARDS.md
       section 12 for the bump policy. 0.1.0 research engine, 0.2.0 live
       market data, 0.3.0 Telegram profit alerts, 0.4.0 broker abstraction
       + unified milestones + Telegram control plane + paper trading,
       0.5.0 live Upstox market data wired into Main via the read-only
       Analytics Token (paper trades on real prices), 0.6.0 symbol
       resolution via the instrument master plus LTP-defaulted price and
       lot-aware position sizing, 0.7.0 weekly instrument-master refresh
       plus on-demand /refresh, 0.8.0 named milestone sets selectable from
       Telegram, with the hard stop moved onto the ladder, 0.9.0
       cost-inclusive breakeven: all thresholds measured net of
       brokerage and taxes, 0.10.0 risk-based sizing, settled P&L at
       exit, and expiry-day guards, 0.11.0 monitoring control (pause,
       release, observe) so trades can be handed back without closing,
       0.12.0 /track replaces /buy, with unknown commands answered
       rather than silently dropped, 0.13.0 runtime /risk plus replies to
       malformed commands, 0.14.0 per-trade buttons for exit and
       monitoring-mode commands, 0.15.0 price-feed lifecycle and failure
       alerts, 0.16.0 open trades persisted across restarts, 0.16.1 all
       phase transitions applied in one tick, 0.16.2 finished trades
       dropped instead of accumulating, 0.17.0 end-of-day close (PHASE_4),
       0.17.1 empty config package removed, 0.18.0 ExitModel and the
       unused TradeContext hooks removed, 0.19.0 exit-order seam with
       fail-safe rejection handling, 0.20.0 /token for the daily
       order-placement credential, 0.21.0 real SELL orders via
       UpstoxExitOrderPlacer, opt-in and guarded against double sells,
       0.24.0 per-trader account registry (Phase 3.5.1 foundation for
       multi-account support), 0.25.0 Main and TelegramCommandHandler
       wired for multiple accounts: one TradeMonitor per registered
       account, Telegram commands routed by chat id, per-account
       trade persistence (Phase 3.5.2/3.5.3), 0.26.0 instrument scope
       narrowed to NIFTY 50 options only: nearest expiry, 15 strikes
       each side of spot, daily strike-window refresh (Phase 3.5.7),
       0.26.1 corrupt-file isolation test between two accounts'
       persistence, closing the last open Phase 3.5 acceptance item,
       0.27.0 broker-fill adoption enforces the same NIFTY-options
       scope as /track: a detected fill outside today's strike window
       is never offered, adopted or auto-adopted, 0.27.1 pom
       reconciliation preflight for the kb-test merge (story #20):
       Lombok bumped to 1.18.42, JUnit to 5.10.2, jackson-databind
       2.21.1 added for the incoming Upstox historical-candle parser,
       0.28.0 kb-test's market-data-engine and future-products docs
       merged in with full history preserved (story #20, step 4.0):
       new com.kbquants.marketdata package (HistoricalCandleFeed,
       UpstoxHistoricalCandleFeed), docs/future-products/, planning
       docs updated to reflect the merge as done, 0.29.0 historical
       price paths for backtesting (story #24): CandleToPricePath
       converts ported candles to the same price-path shape
       StochasticPricePathGenerator produces, HistoricalPricePathSource
       fetches and scopes them to today's tracked NIFTY-options window
       the same way TradeMonitor scopes live fills. -->
  <version>0.29.0-SNAPSHOT</version>
  <packaging>jar</packaging>

  <name>xit-mc</name>
  <url>http://maven.apache.org</url>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.source>17</maven.compiler.source>
    <maven.compiler.target>17</maven.compiler.target>
  </properties>

  <dependencies>

    <!-- Lombok -->
    <dependency>
      <groupId>org.projectlombok</groupId>
      <artifactId>lombok</artifactId>
      <version>1.18.42</version>
      <scope>provided</scope>
    </dependency>

    <!-- JSON Logging -->
    <dependency>
      <groupId>ch.qos.logback</groupId>
      <artifactId>logback-classic</artifactId>
      <version>1.4.11</version>
    </dependency>

    <dependency>
      <groupId>net.logstash.logback</groupId>
      <artifactId>logstash-logback-encoder</artifactId>
      <version>7.4</version>
    </dependency>

    <!-- Apache POI -->
    <dependency>
      <groupId>org.apache.poi</groupId>
      <artifactId>poi-ooxml</artifactId>
      <version>5.2.3</version>
    </dependency>

    <!-- Upstox Java SDK: live market data (WebSocket) + OAuth login -->
    <dependency>
      <groupId>com.upstox.api</groupId>
      <artifactId>upstox-java-sdk</artifactId>
      <version>1.27</version>
    </dependency>

    <!-- Gson: already pulled in transitively by upstox-java-sdk; pinned
         explicitly since we use it directly to parse Telegram's getUpdates
         response. -->
    <dependency>
      <groupId>com.google.code.gson</groupId>
      <artifactId>gson</artifactId>
      <version>2.8.8</version>
    </dependency>

    <!-- JUnit 5 -->
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>5.10.2</version>
      <scope>test</scope>
    </dependency>

    <!-- jackson-databind: needed by the ported market-data-engine's Upstox
         historical-candle parser (kb-test merge, story #20). -->
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
      <version>2.21.1</version>
    </dependency>

  </dependencies>
  <build>
    <plugins>

      <!-- Compiler Plugin -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.11.0</version>
        <configuration>
          <source>17</source>
          <target>17</target>
        </configuration>
      </plugin>

      <!-- JUnit 5 Support -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.1.2</version>
      </plugin>

      <!-- Builds a runnable fat jar (dependencies bundled) via
           `mvn package`, so `java -jar target/xit-mc-1.0-SNAPSHOT.jar`
           works without a separate classpath. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.5.1</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>com.kbquants.Main</mainClass>
                </transformer>
              </transformers>
            </configuration>
          </execution>
        </executions>
      </plugin>

    </plugins>
  </build>

</project>