#!/bin/bash
# Copy this file to run.sh (already gitignored) and fill in your real
# values there. Never commit run.sh -- it will contain your live
# Telegram bot token. See CODING_STANDARDS.md section 7 for why
# credentials are always read from the environment, never baked into
# the build.
#
# Per-trader settings (Telegram chat id, Upstox credentials, capital and
# risk) are NOT here -- they live in accounts.properties (copy it from
# accounts.properties.example). This file holds only the settings that
# apply to the whole deployment, shared across every registered account.

set -euo pipefail

export TELEGRAM_BOT_TOKEN="your-telegram-bot-token-here"
# export TRADING_MODE="paper"   # optional -- "paper" is already the default

# Path to the account registry. Optional -- defaults to
# accounts.properties in the working directory, which matches where
# `mvn package` / `run.sh` normally runs from.
# export ACCOUNTS_FILE="accounts.properties"

# Market data source: "simulated" (default) random-walks from each
# account's entry price; "live" streams real ticks from Upstox, one
# WebSocket per account using that account's own Analytics Token from
# accounts.properties. Uncomment to use live prices.
# export MARKET_DATA="live"

# Newest by modification time, not first alphabetically: after a version
# bump target/ can hold jars from several versions (plus the shade
# plugin's -shaded copy), and picking alphabetically silently runs a
# stale build.
# Close intraday positions at this wall-clock time, before your broker
# squares them off at whatever price it gets. Unset = no end-of-day
# close. The zone defaults to the market's (Asia/Kolkata), not the
# machine's -- a VM on UTC would otherwise fire hours late.
# export EOD_EXIT_TIME="15:15"
# export EOD_TIMEZONE="Asia/Kolkata"

# DANGER: when true, exits place REAL SELL orders with EVERY account's
# broker. Off by default and never implied by any other setting. Also
# needs each account's own daily /token and a registered static IP --
# Upstox refuses orders from anywhere else, however valid the token is.
# export PLACE_REAL_ORDERS="true"
# export ORDER_PRODUCT="I"   # I = intraday, D = delivery

# Watch every account's broker order stream, so a buy punched into the
# Upstox app turns up in that account's chat without being typed in
# again. Detected positions are offered, never taken: the stream carries
# the whole account, including hedges and other strategies, and managing
# those uninvited would apply exit rules never meant for them. Accept
# with the button or /adopt. Needs that account's /token before its
# stream can start.
# export WATCH_BROKER_FILLS="true"

# Directory where each account's open trades are persisted, one file
# named <accountId>.json per account. Optional -- defaults to
# ~/.xit-mc/open-trades/.
# export TRADE_STATE_DIR="/path/to/state/dir"

JAR=$(find target -maxdepth 1 -name 'xit-mc-*.jar' ! -name 'original-*' -printf '%T@ %p\n' \
  | sort -rn | head -n 1 | cut -d' ' -f2-)

if [ -z "$JAR" ]; then
  echo "No runnable jar found in target/. Run 'mvn package' first." >&2
  exit 1
fi

exec java -jar "$JAR"
